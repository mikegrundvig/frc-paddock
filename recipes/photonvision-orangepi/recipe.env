# shellcheck shell=bash disable=SC2034 # the engine's scripts use these values
# PhotonVision on an Orange Pi 5-family board (README.md): PhotonVision's own image for the board,
# its jar pinned by the lock, Spotter's agent and PhotonVision's pack, a read-only root and /data.
# What a recipe provides: ../README.md.

RECIPE_TITLE="PhotonVision on Orange Pi"
# The boards it builds for: one file each in boards/.
RECIPE_BOARDS="orangepi-5 orangepi-5b orangepi-5-plus orangepi-5-pro orangepi-5-max"
# The images are 64-bit ARM, provisioned on GitHub's ARM runners, so nothing is emulated.
RECIPE_ARCH=arm64
RECIPE_RUNNER=ubuntu-24.04-arm
# The version lock: the software's version, its inputs, and each board's base image, by checksum.
RECIPE_LOCK=photonvision.lock
# The lock's inputs the engine downloads beside the base image, as name=path (yq paths).
RECIPE_INPUTS="photonvision.jar=.jar"
# The stamp label the lock's version goes under, and the packs the image carries.
RECIPE_VERSION_LABEL=photonvisionVersion
RECIPE_PACKS="photonvision"
# The login the base image has, which SSH keys are installed for.
RECIPE_SSH_USER=photon
# Where the software keeps what it writes, on /data and where it looks for it.
DATA_PV_CONFIG=photonvision_config
IMG_PV_DIR=/opt/photonvision
IMG_PV_JAR=/opt/photonvision/photonvision.jar
IMG_PV_CONFIG=/opt/photonvision/photonvision_config
